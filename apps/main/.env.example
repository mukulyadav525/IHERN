# IHERN Next.js - environment configuration
#
# Copy to .env.production.local on the server (or set these in the service
# that runs the app). Never commit real values.
#
# This app uses the EXISTING IHERN databases and works with the IHERN Blog
# (apps/blog). Variable names match the PHP site's where they overlap, so a
# server configured for the PHP site needs few changes.
#
# Variables marked [build] are read when you run `npm run build`; set them
# before building, and rebuild after changing them.

# --- Where the site lives -----------------------------------------------------

# production on the live server; development only on a developer machine
# (development enables localhost sign-on addresses and a built-in test secret).
IHERN_ENV=production

# [build] Serve the site under a sub-path. The PHP site is at
# https://iiitd.ac.in/IHERN/, so to replace it in place use /IHERN.
# Leave empty to serve from the domain root.
NEXT_PUBLIC_BASE_PATH=/IHERN

# [build] The public address of the site, base path included, trailing slash.
# Used in emails, canonical URLs and the sitemap. Must match IHERN_SITE_URL in
# the blog's settings (apps/blog).
IHERN_SITE_URL=https://iiitd.ac.in/IHERN/

# The IHERN Blog (apps/blog). Post links on the Blogs page point here, and it
# is the blog the main site signs readers in for.
IHERN_BLOG_URL=https://ihernblog.iiitd.ac.in

# Behind a proxy that does not pass the original Host header, list the public
# host so form submissions are accepted (e.g. iiitd.ac.in). Usually not needed
# with Apache's "ProxyPreserveHost On".
# IHERN_ALLOWED_ORIGINS=iiitd.ac.in

# --- Databases (the existing ones) --------------------------------------------
# cdnm       IHERN accounts (blog_subscribers), blog subscriptions, SSO codes
# ihern2024  membership registrations / member directory (studentregistration)
#
# Without these, account and member features say the service is unavailable;
# they never fall back to made-up data.

IHERN_DB_HOST=localhost
# IHERN_DB_PORT=3306
# Or the server's Unix socket (what PHP's "localhost" uses):
# IHERN_DB_SOCKET=/var/lib/mysql/mysql.sock   (Ubuntu/Debian: /var/run/mysqld/mysqld.sock)
# Connections per database for this site (default 10), and how long a query
# may take before it is abandoned (default 10000 ms).
# IHERN_DB_POOL_SIZE=10
# IHERN_DB_QUERY_TIMEOUT_MS=10000

IHERN_DB_CDNM_NAME=cdnm
IHERN_DB_CDNM_USER=
IHERN_DB_CDNM_PASS=

IHERN_DB_IHERN2024_NAME=ihern2024
IHERN_DB_IHERN2024_USER=
IHERN_DB_IHERN2024_PASS=

# --- Secrets --------------------------------------------------------------------

# Signs the IHERN session cookies. Long and random:  openssl rand -hex 32
IHERN_SESSION_SECRET=

# Shared with the blog for single sign-on: the SAME value as
# IHERN_SSO_CLIENT_SECRET in the blog's settings (apps/blog). Unset = single
# sign-on stays switched off.
IHERN_SSO_BLOG_SECRET=

# --- Sign-in ----------------------------------------------------------------------

# Limit IHERN accounts to these email domains (comma separated). Empty = any.
# IHERN_ALLOWED_EMAIL_DOMAINS=iiitd.ac.in

# Google sign-in: the button appears only when both are set. Google returns to
# IHERN_SITE_URL + "blog-oauth.php" - the same address the PHP site registers,
# so the existing Authorized redirect URI in Google Cloud Console keeps working.
# IHERN_GOOGLE_CLIENT_ID=
# IHERN_GOOGLE_CLIENT_SECRET=
# IHERN_GOOGLE_REDIRECT_URI=

# --- Outgoing mail ------------------------------------------------------------------
# Subscription confirmations, new-post alerts, membership confirmations and
# password reset links. With nothing set, mail is skipped (and logged); the
# actions themselves still work and say when an email could not be sent.

# IHERN_SMTP_HOST=smtp.gmail.com
# IHERN_SMTP_PORT=587
# IHERN_SMTP_USER=no-reply@iiitd.ac.in
# IHERN_SMTP_PASS=
# Sender for every message. Gmail only sends as the signed-in account, so set
# this to that address, e.g. "IHERN <no-reply@iiitd.ac.in>".
# IHERN_MAIL_FROM=

# Local testing only: write messages to .data/mail.log instead of sending.
# IHERN_MAIL_TRANSPORT=file

# --- Files ----------------------------------------------------------------------------

# Where membership photographs are stored (shown to admins at /membership/admin).
# Point this at the PHP site's applications/uploadDoc directory so photographs
# members already uploaded keep showing.
# IHERN_UPLOAD_DIR=/var/www/html/IHERN/applications/uploadDoc

# Only for a plain-http preview of a production build (cookies are otherwise
# marked Secure and need https).
# IHERN_INSECURE_COOKIES=1
