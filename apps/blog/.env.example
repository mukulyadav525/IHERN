# IHERN Blog - settings
#
# Copy to apps/blog/.env.production.local on the server (or set these in the
# service that runs the blog). Never commit real values.
#
# Values marked [build] are read by `npm run build:blog`; set them first and
# rebuild after changing them.

# production on the live server; development only on a developer machine.
IHERN_ENV=production

# [build] The blog's public address, no trailing slash. It lives under the
# main site's address: https://ihern.iiitd.edu.in/blog
IHERN_BLOG_URL=https://ihern.iiitd.edu.in/blog

# [build AND start] The blog's path on that host (the end of IHERN_BLOG_URL).
# Read by `npm run build` and again by `next start`: keep it in this file.
NEXT_PUBLIC_BASE_PATH=/blog

# [build] The main IHERN site, with a trailing slash (readers sign in there).
IHERN_SITE_URL=https://ihern.iiitd.edu.in/

# Optional: if the server cannot reach the main site at its public address
# (firewall, same machine), the address it can use for the server-to-server
# sign-in calls, e.g. http://127.0.0.1:3000
# IHERN_SSO_INTERNAL_URL=

# --- Single sign-on with the main site ------------------------------------------
# The client id and secret the main site has for the blog. The secret must
# equal IHERN_SSO_BLOG_SECRET in the main site's settings.  openssl rand -hex 32
IHERN_SSO_CLIENT_ID=ihern-blog
IHERN_SSO_CLIENT_SECRET=

# Signs the blog's short-lived sign-in cookies. Long and random.
IHERN_SESSION_SECRET=

# --- Database: the same cdnm database as the main site --------------------------
IHERN_DB_HOST=localhost
# IHERN_DB_PORT=3306
# IHERN_DB_SOCKET=/var/lib/mysql/mysql.sock   (Ubuntu/Debian: /var/run/mysqld/mysqld.sock)
# Connections per database for this site (default 10), and how long a query
# may take before it is abandoned (default 10000 ms).
# IHERN_DB_POOL_SIZE=10
# IHERN_DB_QUERY_TIMEOUT_MS=10000
IHERN_DB_CDNM_NAME=cdnm
IHERN_DB_CDNM_USER=
IHERN_DB_CDNM_PASS=
# Optional: the membership database, read only to show "Membership admin" in
# a staff member's account menu (an active ihern2024.adminlogin row with the
# same email). Without it that link appears only on the main site.
# IHERN_DB_IHERN2024_NAME=ihern2024
# IHERN_DB_IHERN2024_USER=
# IHERN_DB_IHERN2024_PASS=
# Dates are stored in Indian time, as WordPress stored them.
# IHERN_DB_TIMEZONE=+05:30

# --- Uploaded images ------------------------------------------------------------
# A folder that survives redeploys. The WordPress migration copies the old
# wp-content/uploads here; images are served at /wp-content/uploads/...
BLOG_UPLOAD_DIR=/var/lib/ihern-blog/uploads
# Smaller copies of uploaded images are made on demand and kept here
# (default: .next/cache/ihern-images inside apps/blog).
# BLOG_IMAGE_CACHE_DIR=

# --- Mail: subscription confirmations, new-post emails, comment alerts --------
# IHERN_SMTP_HOST=smtp.gmail.com
# IHERN_SMTP_PORT=587
# IHERN_SMTP_USER=ihern@iiitd.ac.in
# IHERN_SMTP_PASS=
# Where the server cannot reach the mail server directly, through an SSH tunnel
# (ssh -N -L 127.0.0.1:2465:smtp.gmail.com:465 user@host-that-can): host
# 127.0.0.1, port 2465, and these two, so TLS is still checked against Gmail.
# IHERN_SMTP_SECURE=1
# IHERN_SMTP_TLS_SERVERNAME=smtp.gmail.com
# Leave IHERN_MAIL_FROM unset: messages then come from "IHERN Blog <ihern@iiitd.ac.in>".
# IHERN_MAIL_FROM=

# Behind a proxy that rewrites the Host header, the public host, so admin
# forms are accepted:
# IHERN_ALLOWED_ORIGINS=ihern.iiitd.edu.in

# Only for a plain-http preview of a production build:
# IHERN_INSECURE_COOKIES=1
